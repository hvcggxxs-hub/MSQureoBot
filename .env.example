# Required bot and AI settings
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
GEMINI_API_KEY=PUT_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Telegram numeric ID of the administrator
ADMIN_ID=8387759222

# IMPORTANT: preserve the exact original key for existing encrypted data.
# Must decode to exactly 32 bytes. Never replace it after users.enc.json exists.
DATA_ENCRYPTION_KEY=PUT_BASE64_32_BYTE_KEY_HERE
DATA_DIR=./data

# Qureo (Linux host recommended for Playwright)
QUREO_LOGIN_URL=https://me-portal.qureo.education/login
HEADLESS=true

# Optional Cloudflare Workers AI image generation
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional selectors. Change only after inspecting the supported Qureo interface.
LOGIN_USER_SELECTOR=input[type="email"], input[name*="user" i], input[name*="email" i], input[type="text"]
LOGIN_PASS_SELECTOR=input[type="password"]
LOGIN_SUBMIT_SELECTOR=button[type="submit"], input[type="submit"]
QUESTION_SELECTOR=[data-question], .question, [class*="question" i], main
OPTION_SELECTOR=input[type="radio"]
SUBMIT_ANSWER_SELECTOR=button[type="submit"], button:has-text("تحقق"), button:has-text("إرسال"), button:has-text("Submit"), button:has-text("Check"), button:has-text("التالي"), button:has-text("Next")
